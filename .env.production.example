# Copier en .env.production sur le serveur et remplacer chaque valeur. Ce fichier ne doit jamais être versionné.

# Domaine public : Caddy obtient le certificat HTTPS pour ce nom (laisser « localhost » pour un essai local)
DOMAINE=localhost
APP_URL=https://localhost
FRONTEND_URL=https://localhost
CORS_ORIGINES=https://localhost

APP_NAME=KaarPro
APP_ENV=production
APP_DEBUG=false
# Générer avec : docker compose -f docker-compose.prod.yml run --rm api php artisan key:generate --show
APP_KEY=
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_DATABASE=kaarpro
DB_USERNAME=kaarpro
DB_PASSWORD=a-remplacer-par-un-mot-de-passe-long

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

# Seul compte créé au premier démarrage
ADMIN_EMAIL=admin@kaarpro.sn
ADMIN_PASSWORD=a-remplacer

SANCTUM_EXPIRATION=10080
COMMISSION_LOCATION=10
COMMISSION_VENTE=3
# Paiement Wave / Orange Money par PayTech. « simulateur » tant que le compte PayTech n'est pas ouvert.
# PayTech exige que APP_URL soit en HTTPS pour envoyer ses notifications (IPN) à /api/webhooks/paytech.
PAIEMENT_PASSERELLE=simulateur
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
# test : PayTech débite réellement 100 à 150 FCFA par paiement ; prod : après activation du compte par PayTech
PAYTECH_ENV=test

# Version des images à déployer (latest ou l'identifiant d'un commit)
VERSION=latest

# Ports publiés (80 et 443 sur un serveur ; autres valeurs pour un essai sur un poste où ils sont pris)
PORT_HTTP=80
PORT_HTTPS=443
